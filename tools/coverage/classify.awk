  FS = "\t"; OFS = "\t"
  split("ans arguments break case catch classdef continue else elseif end for function global if otherwise parfor persistent return switch try while varargin varargout nargin nargout spmd_feval parallel_function precedence lists script empty", kw, " ")
  for (k in kw) cat[kw[k]] = "keyword"
