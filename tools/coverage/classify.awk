  ide = "desktop preferences more echo keyboard diary open cameramenu cameratoolbar cmapeditor colormapeditor plotedit pan zoom rotate3d datacursormode uicontrol uimenu uicontextmenu uiaxes print printdlg printjob printpreview printtables printtemplate setprinttemplate getprinttemplate pagesetupdlg exportsetupdlg figureheaderdlg gtext rbbox findprinters opengl rendererinfo capturescreen methodsview cellplot funtool taylortool openmn openxvc openxvz mupad mupadengine mupadwelcome allMuPADNotebooks convertMuPADNotebook symengine matlabFunctionBlock simscapeEquation symReadSSCParameters symReadSSCVariables symWriteSSC release getFigureToolManager figureToolbarCreateFcn exportapp shg orient dateTickPicker regionpicker vertexpicker editInteraction panInteraction regionZoomInteraction rotateInteraction rulerPanInteraction zoomInteraction dataTipInteraction disableDefaultInteractivity enableDefaultInteractivity enableLegacyExplorationModes resetplotview refreshdata linkprop linkaxes hgexport hgload hgsave savefig openfig openFigure saveFigure copygraphics graymon whitebg colordef vga closereq inspect quit exit logo bench membrane callgraphviz isstudent isdeployed ismcc getmcruserdata setmcruserdata batchStartupOptionUsed savepath path2rc rehash inmem findfile finfo syntax depfunprophelper mlock munlock mislocked"
  split(ide, a, " "); for (k in a) why[a[k]] = "desktop, IDE, GUI, printing or interactive tool"
  dev = "audiodevinfo audiodevreset audioplayer audiorecorder sound soundsc VideoReader VideoWriter mmfileinfo avifinfo aviinfo avgate prefspanel audiouniquename getframe movie moviein frame2im im2frame"
  split(dev, a, " "); for (k in a) why[a[k]] = "audio/video devices or screen capture"
  fmt = "cdfepoch cdfinfo cdfread cdfwrite fitsdisp fitsinfo fitsread fitswrite h5create h5disp h5info h5read h5readatt h5write h5writeatt hdf hdf5 hdf5info hdf5read hdf5write hdfan hdfdf24 hdfdfr8 hdfh hdfhd hdfhe hdfhx hdfinfo hdfml hdfpt hdfread hdfv hdfvf hdfvh hdfvs nccreate ncdisp ncinfo ncread ncreadatt ncwrite ncwriteatt ncwriteschema multibandread multibandwrite Tiff callSoapService createClassFromWsdl createSoapMessage parseSoapResponse sendmail daqread memmapfile memmap_data_handle_holder"
  split(fmt, a, " "); for (k in a) why[a[k]] = "scientific file format (HDF/netCDF/CDF/FITS/TIFF) or web service"
  geo = "geoaxes geobasemap geobubble geodensityplot geolimits geoplot geoscatter geotickformat"
  split(geo, a, " "); for (k in a) why[a[k]] = "needs internet map tiles"
  internal = "DefaultObject internalArrayUtil BasicArray SimTimeseries ValueArray VirtualArray abstracttimemetadata dataChangeEvent hds metadata simulinkts2ts timeseriesArray tsAlignSizes tsAnalyzeAbsTime tsChkTime tsIsDateFormat tsIsSameTime tsarrayFcn tsdata tsdateinterval tsgetDateFormat tsgetrelativetime tsinterp tsnaniqr tsnanmax tsnanmean tsnanmedian tsnanmin tsnanmode tsnanstd tsnansum tsnanvar tsnewevent tspnmatch tsprctile tspvformat tssorttime tsunitconv utTrimNans uttsget variable addLink callAllOptimOutputAndPlotFcns callAllOptimOutputFcns callAllOptimPlotFcns createCellArrayOfFunctions createProblemStruct createSolverStruct separateOptimStruct validOptimProblemStruct validateopts_UseParallel xychk xyzchk xyzvchk automesh splncore qhull pwch ParallelException arrowline axischild axisobj axistext basicfitdatastat doclick dokeypress domymenu doresize editline editrect enddrag fighandle figobj figtoolset getobj getorcreateobj getscribecontextmenu getscribeobjectdata hgbin jpropeditutils middrag moveaxis prepdrag putdowntext scribeclearmode scribeeventhandler scribehandle scribehgobj scriberestoresavefcns scribetextdlg setscribecontextmenu setscribeobjectdata texlabel defaultItemHitCallback deselectall getselectobjects hgconvertunits legendcolorbarlayout legendinfo scribealign scribeccp scribecursors selectobject snaptogrid startscribeobject startscribepinning axescheck parseChartInputs parseparams makebars plotutils usev6plotapi isplotchild plotchild plotdoneevent changeseriestype parseplotapi figcopytemplatelistener figcopytemplatelistener_legacy defaulterrorcallback hgrc hgaddbehavior hgbehaviorfactory hggetbehavior hasbehavior hgclose hgdisp hggetdisp hgsetdisp hgfeval copyoptionsfcn datetickstr bwcontr timercb checkIgnoreAnalyticConstraintsValue symFunType checkSyntacticWarnings matfinfo partialpath deployprefdir colstyle isUnderlyingType num2ruler ruler2num handle2struct struct2handle"
  split(internal, a, " "); for (k in a) why[a[k]] = "internal helper, not a user function"
  demo = "amp1dae ballode batonode brussode burgersode ddex1 ddex1de ddex1delays ddex1hist ddex2 ddex3 ddex4 ddex5 emdenbvp fem1ode fem2ode fsbvp hb1dae hb1ode iburgersode ihb1dae kneeode lorenz lotka mat4bvp odeexamples orbitode pdex1 pdex1bc pdex1ic pdex1pde pdex2 pdex3 pdex4 pdex5 rcbvp rigidode shockbvp threebvp twobc twobvp twoode vanderpoldemo vdp1 vdp1000 vdpode weissinger"
  split(demo, a, " "); for (k in a) why[a[k]] = "MATLAB example file"
}
NR == FNR { missing[$1] = 1; next }
{
  name = $2; folder = $1
  if (!(name in missing)) { print folder, name, "done", ""; next }
  if (name in cat) { print folder, name, "keyword", "language syntax: check it works"; next }
  if (name in why) { print folder, name, "out", why[name]; next }
  print folder, name, "todo", ""
}
